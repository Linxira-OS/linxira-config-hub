            ;;
        dev)
            info "Installing development packages..."
            sudo pacman -S --noconfirm --needed \
                rust go nodejs typescript python cmake git \
                neovim tmux docker podman distrobox
            success "Development environment ready"
            ;;
        ai)
            info "Installing AI/ML packages..."
            sudo pacman -S --noconfirm --needed \
