# ─── Power Management ───────────────────────────────────────

power_manage() {
    local action=${1:-status}

    case $action in
        status)
            header "Power Settings"
            # Sleep/suspend
            local sleep_val=$(cat /etc/systemd/sleep.conf 2>/dev/null | grep "^#HandleSuspendKey\|^HandleSuspendKey" | awk -F= '{print $2}' | xargs || echo "suspend")
            local lid_val=$(cat /etc/systemd/sleep.conf 2>/dev/null | grep "^#HandleLidSwitch\|^HandleLidSwitch" | awk -F= '{print $2}' | xargs || echo "suspend")
            info "Suspend on sleep key: $sleep_val"
            info "Suspend on lid close: $lid_val"

            # Screen blanking
            local blanking
            if grep -rq "Blanking" /etc/sddm.conf.d/ 2>/dev/null; then
                blanking="configured"
            else
                blanking="default"
            fi
            info "Screen blanking: $blanking"

            # Sleep mask
            local masked=$(systemctl is-masked sleep.target 2>/dev/null || echo "not masked")
            if [ "$masked" = "masked" ]; then
                info "sleep.target: MASKED (disabled)"
            else
                info "sleep.target: active"
            fi
            echo ""
            ;;
        nosleep)
            require_root
            info "Disabling auto-sleep/suspend..."
            sudo sed -i 's/^#HandleSuspendKey=.*/HandleSuspendKey=ignore/' /etc/systemd/sleep.conf 2>/dev/null || true
            sudo sed -i 's/^HandleSuspendKey=.*/HandleSuspendKey=ignore/' /etc/systemd/sleep.conf 2>/dev/null || true
            sudo sed -i 's/^#HandleLidSwitch=.*/HandleLidSwitch=ignore/' /etc/systemd/sleep.conf 2>/dev/null || true
            sudo sed -i 's/^HandleLidSwitch=.*/HandleLidSwitch=ignore/' /etc/systemd/sleep.conf 2>/dev/null || true
            # Also mask sleep targets
            sudo systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target 2>/dev/null || true
            success "Auto-sleep and suspend disabled"
            ;;
        nosuspend)
            require_root
            info "Disabling suspend on lid close..."
            sudo sed -i 's/^#HandleLidSwitch=.*/HandleLidSwitch=ignore/' /etc/systemd/sleep.conf 2>/dev/null || true
            sudo sed -i 's/^HandleLidSwitch=.*/HandleLidSwitch=ignore/' /etc/systemd/sleep.conf 2>/dev/null || true
            success "Lid close suspend disabled"
            ;;
        noscreen)
            require_root
            info "Disabling screen blanking..."
            # KDE/Plasma
            local user home kwrite
            user=$(target_user)
            home=$(getent passwd "$user" 2>/dev/null | cut -d: -f6 || true)
            kwrite=$(command -v kwriteconfig6 || command -v kwriteconfig5 || true)
            if [[ -n $kwrite && -n $user && -n $home ]]; then
                sudo -u "$user" env HOME="$home" "$kwrite" --file kscreenlockerrc --group Daemon --key Autolock false
                sudo -u "$user" env HOME="$home" "$kwrite" --file kscreenlockerrc --group Daemon --key Timeout 0
            fi
            # SDDM
            sudo mkdir -p /etc/sddm.conf.d
            echo -e "[General]\nGreeterEnv=QT_SCREEN_SCALE_FACTORS=1" | sudo tee /etc/sddm.conf.d/no-blank.conf >/dev/null
            success "Screen blanking disabled"
            ;;
        restore)
            require_root
            info "Restoring default power settings..."
            sudo cp /etc/systemd/sleep.conf /etc/systemd/sleep.conf.bak 2>/dev/null || true
            sudo systemctl unmask sleep.target suspend.target hibernate.target hybrid-sleep.target 2>/dev/null || true
            sudo sed -i 's/^HandleSuspendKey=.*/#HandleSuspendKey=suspend/' /etc/systemd/sleep.conf 2>/dev/null || true
            sudo sed -i 's/^HandleLidSwitch=.*/#HandleLidSwitch=suspend/' /etc/systemd/sleep.conf 2>/dev/null || true
            success "Default power settings restored"
            ;;
        *)
            error "Unknown power action: $action (use status/nosleep/nosuspend/noscreen/restore)"
            ;;
    esac
}

# ─── Network Diagnostics ────────────────────────────────────

net_diag() {
    header "Network Diagnostics"

    # NetworkManager status
    header "NetworkManager"
    if systemctl is-active NetworkManager &>/dev/null; then
        success "NetworkManager: ACTIVE"
        nmcli general status 2>/dev/null || true
    else
        warn "NetworkManager: INACTIVE"
    fi

    # systemd-networkd status
    header "systemd-networkd"
    if systemctl is-active systemd-networkd &>/dev/null; then
        warn "systemd-networkd: ACTIVE (may conflict with NetworkManager)"
    else
        success "systemd-networkd: INACTIVE (expected when using NetworkManager)"
    fi

    # Network interfaces
    header "Network Interfaces"
    ip -br addr 2>/dev/null || ifconfig -a 2>/dev/null || true

    # Default gateway
    header "Default Gateway"
    ip route show default 2>/dev/null || true

    # DNS
    header "DNS Servers"
    if [ -f /etc/resolv.conf ]; then
        grep -E '^nameserver' /etc/resolv.conf 2>/dev/null || warn "No nameservers in /etc/resolv.conf"
    else
        warn "/etc/resolv.conf not found"
    fi
    # Also show NetworkManager DNS
    if command -v nmcli &>/dev/null && systemctl is-active NetworkManager &>/dev/null; then
        echo ""
        info "NetworkManager DNS (per connection):"
        nmcli -f IP4.DNS con show 2>/dev/null | head -10 || true
    fi

    # DNS resolution test
    header "DNS Resolution Test"
    if host archlinux.org &>/dev/null; then
        success "DNS resolution: OK (archlinux.org resolved)"
    else
        warn "DNS resolution: FAILED (cannot resolve archlinux.org)"
    fi

    # Ping tests
    header "Connectivity Tests"
    if ping -c 2 -W 3 8.8.8.8 &>/dev/null; then
        success "Ping 8.8.8.8: OK"
    else
        warn "Ping 8.8.8.8: FAILED (no internet or ICMP blocked)"
    fi
    if ping -c 2 -W 3 archlinux.org &>/dev/null; then
        success "Ping archlinux.org: OK"
    else
        warn "Ping archlinux.org: FAILED"
    fi

    # Firewall
    header "Firewall"
    if command -v ufw &>/dev/null; then
        local ufw_status
        ufw_status=$(sudo ufw status 2>/dev/null | head -1)
        if echo "$ufw_status" | grep -q "active"; then
            info "UFW: ACTIVE"
        else
            info "UFW: INACTIVE"
        fi
    elif command -v iptables &>/dev/null; then
        local rule_count
        rule_count=$(sudo iptables -L -n 2>/dev/null | grep -c "^Chain" || echo 0)
        info "iptables: $rule_count chains active"
    else
        info "No firewall detected"
    fi

    echo ""
}

net_fix() {
    header "Fixing Network Issues"
    require_root

    # Stop/mask systemd-networkd if NetworkManager is preferred
    header "Checking systemd-networkd"
    if systemctl is-active systemd-networkd &>/dev/null; then
        info "Stopping systemd-networkd..."
        sudo systemctl stop systemd-networkd
        sudo systemctl disable systemd-networkd
        sudo systemctl mask systemd-networkd
        success "systemd-networkd stopped, disabled, and masked"
    else
        success "systemd-networkd already inactive"
    fi

    # Also mask systemd-resolved if using NetworkManager's DNS
    if systemctl is-active systemd-resolved &>/dev/null; then
        info "Stopping systemd-resolved..."
        sudo systemctl stop systemd-resolved
        sudo systemctl disable systemd-resolved
        sudo systemctl mask systemd-resolved
        success "systemd-resolved stopped and masked"
    fi

    # Restart NetworkManager
    header "Restarting NetworkManager"
    if systemctl is-active NetworkManager &>/dev/null; then
        sudo systemctl restart NetworkManager
        success "NetworkManager restarted"
    else
        info "NetworkManager not running, starting..."
        sudo systemctl enable --now NetworkManager
        success "NetworkManager enabled and started"
    fi

    # Fix DNS - ensure resolv.conf has working nameservers
    header "Fixing DNS"
    if ! grep -qE '^nameserver' /etc/resolv.conf 2>/dev/null; then
        info "No nameservers found, adding defaults..."
        echo -e "# Generated by linxira-config net fix\nnameserver 8.8.8.8\nnameserver 1.1.1.1" | sudo tee /etc/resolv.conf >/dev/null
        success "DNS nameservers set: 8.8.8.8, 1.1.1.1"
    else
        success "DNS nameservers already configured"
    fi

    echo ""
    success "Network fix complete. Run 'linxira-config net diag' to verify."
}

net_dns() {
    local action=${1:-show}
    local dns_ip=${2:-}

    case $action in
        show|status)
            header "Current DNS Configuration"
            if [ -f /etc/resolv.conf ]; then
                grep -E '^nameserver' /etc/resolv.conf 2>/dev/null | while read -r line; do
                    info "$line"
                done
            else
                warn "/etc/resolv.conf not found"
            fi
            if command -v nmcli &>/dev/null && systemctl is-active NetworkManager &>/dev/null; then
                echo ""
                info "NetworkManager DNS per connection:"
                nmcli -f NAME,IP4.DNS con show 2>/dev/null | grep -v "^NAME" | grep -v "^--" | head -10 || true
            fi
            echo ""
            ;;
        set|add)
            [ -z "$dns_ip" ] && error "Please specify a DNS server IP: linxira-config net dns set <ip>"
            validate_dns_server "$dns_ip"
            require_root
            # Remove existing nameservers and add the new one + fallback
            if [ -f /etc/resolv.conf ]; then
                sudo sed -i '/^nameserver/d' /etc/resolv.conf
            fi
            echo "nameserver $dns_ip" | sudo tee -a /etc/resolv.conf >/dev/null
            # Add fallback if different
            if [ "$dns_ip" != "8.8.8.8" ]; then
                echo "nameserver 8.8.8.8" | sudo tee -a /etc/resolv.conf >/dev/null
            fi
            if [ "$dns_ip" != "1.1.1.1" ]; then
                echo "nameserver 1.1.1.1" | sudo tee -a /etc/resolv.conf >/dev/null
            fi
            success "DNS set to $dns_ip (with fallbacks)"
            # Verify
            if host archlinux.org &>/dev/null; then
                success "DNS resolution test: PASSED"
            else
                warn "DNS resolution test: FAILED - check if $dns_ip is reachable"
            fi
            ;;
        *)
            error "Unknown DNS action: $action (use show/set)"
            ;;
    esac
}

# ─── Post-install Packages ──────────────────────────────────

install_packages() {
    local category=${1:-}
    [[ -n $category ]] || error "Specify a profile. Use: linxira-config install help"
    case "$category" in
        help|--help|-h) catalog_list_profiles ;;
        app|application|applications)
            shift
            ((${#@} > 0)) || { catalog_list_applications; return; }
            install_catalog_applications "$@"
            ;;
        *) shift; install_catalog_profiles "$category" "$@" ;;
    esac
}

# ─── System Info ─────────────────────────────────────────────

show_info() {
    header "System Information"
    echo "  OS:       $(grep PRETTY_NAME /etc/os-release | cut -d'"' -f2)"
    echo "  Kernel:   $(uname -r)"
    echo "  Arch:     $(uname -m)"
    echo "  CPU:      $(lscpu | grep "Model name" | cut -d: -f2 | xargs)"
    echo "  Memory:   $(free -h | awk '/^Mem:/{print $2}')"
    echo "  Hostname: $(hostname)"
    echo ""
    header "GPU"
    lspci | grep -E "VGA|3D" | awk -F': ' '{print "  " $2}' || echo "  No GPU detected"
    echo ""
    header "Installed Kernels"
    pacman -Q 2>/dev/null | awk '
        $1 ~ /^linux(-lts|-zen|-hardened)?$/ { print "  " $1, $2; found=1 }
        END { if (!found) print "  (none detected)" }
    '
}

runtime_status() {
    local tool
    header "Runtime And Package Managers"
    for tool in pacman paru nix python uv node npm rustc cargo go conda mamba apptainer podman; do
        if command -v "$tool" >/dev/null 2>&1; then
            printf '  %-12s installed (%s)\n' "$tool" "$(command -v "$tool")"
        else
            printf '  %-12s unavailable\n' "$tool"
        fi
    done
    printf '  %-12s unresolved (no verified package or implementation)\n' wise
}

# ─── Main Dispatch ───────────────────────────────────────────

case "${1:-help}" in
    mirror)
        case "${2:-arch}" in
            list) mirror_list arch ;;
            speed) mirror_speed arch "${3:-}" ;;
            set) mirror_set arch "${3:-}" ;;
            reset) mirror_reset arch ;;
            arch|npm|pip|aur|flatpak)
                case "${3:-list}" in
                    list) mirror_list "$2" ;;
                    speed) mirror_speed "$2" "${4:-}" ;;
                    set) mirror_set "$2" "${4:-}" ;;
                    reset) mirror_reset "$2" ;;
                    *) error "Unknown mirror action: ${3:-} (use list/speed/set/reset)" ;;
                esac
                ;;
            *) error "Unknown mirror type: ${2:-} (use arch/npm/pip/aur/flatpak)" ;;
        esac
        ;;
    source)
        source_list
        ;;
    workflow)
        workflow_apply "${2:-help}"
        ;;
    service)
        service_manage "${2:-}" "${3:-}"
        ;;
    security)
        case "${2:-status}" in
            status) security_status ;;
            harden) security_harden ;;
            ufw) ufw_manage "${3:-status}" ;;
            *) error "Unknown security action: ${2:-} (use status/harden/ufw)" ;;
        esac
        ;;
    ssh)
        ssh_manage "${2:-status}"
        ;;
    rdp)
        rdp_manage "${2:-on}"
        ;;
    virt)
        virt_manage "${2:-status}"
        ;;
    power)
        power_manage "${2:-status}"
        ;;
    install)
        shift
        install_packages "${1:-help}" "${@:2}"
        ;;
    gpu)
        gpu_action "${2:-info}"
        ;;
    net)
        case "${2:-help}" in
            diag) net_diag ;;
            fix) net_fix ;;
            dns) net_dns "${3:-show}" "${4:-}" ;;
            *) error "Unknown net action: ${2:-} (use diag/fix/dns)" ;;
        esac
        ;;
    info)
        show_info
        ;;
    runtime)
        case "${2:-status}" in
            status) runtime_status ;;
            *) error "Unknown runtime action: ${2:-} (use status)" ;;
        esac
        ;;
    help|--help|-h)
        show_help
        ;;
    version|--version|-v)
        echo "linxira-config v${VERSION}"
        ;;
    *)
        error "Unknown command: $1"
        show_help
        ;;
esac
