mirror_speed() {
    header "Testing Mirror Speeds"
    info "Testing Arch Linux mirrors..."
    if command -v reflector &>/dev/null; then
        sudo reflector --latest 5 --sort rate --protocol https --save /etc/pacman.d/mirrorlist
        success "Mirror list updated with fastest mirrors"
    else
        warn "reflector not installed. Installing..."
        sudo pacman -S --noconfirm reflector
        sudo reflector --latest 5 --sort rate --protocol https --save /etc/pacman.d/mirrorlist
        success "Mirror list updated with fastest mirrors"
    fi
}

mirror_set() {
