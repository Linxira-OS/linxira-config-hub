# ─── Workflow Templates ──────────────────────────────────────

catalog_require() {
    command -v jq >/dev/null || error "jq is required to read the Linxira catalog"
    [[ -r $CATALOG_PATH ]] || error "Linxira catalog not found: $CATALOG_PATH"
    jq -e '.catalogVersion == 2 and (.sources | type == "array") and (.profiles | type == "array")' \
        "$CATALOG_PATH" >/dev/null || error "The Linxira catalog is invalid"
}

catalog_list_profiles() {
    catalog_require
    jq -r '.profiles[] | "  \(.id)\t\(.name.en)"' "$CATALOG_PATH"
}

catalog_list_applications() {
    catalog_require
    jq -r '.applications[] | "  \(.id)\t\(.name.en)"' "$CATALOG_PATH"
}

catalog_profile_packages() {
    local profile=$1
    catalog_require
    jq -er --arg profile "$profile" \
        '[.profiles[] | select(.id == $profile and .source == "arch")][0].packages[]' \
        "$CATALOG_PATH" 2>/dev/null || error "Unknown native profile: $profile"
}

catalog_application_packages() {
    local application=$1
    catalog_require
    jq -er --arg application "$application" \
        '[.applications[] | select(.id == $application and .source == "arch" and .installer == true)][0].packages[]' \
        "$CATALOG_PATH" 2>/dev/null || error "Unknown native application: $application"
}

install_catalog_profile() {
    install_catalog_profiles "$1"
}

install_catalog_profiles() {
    local profile packages_file profile_name
    local -a packages=()
    ((${#@} > 0)) || error "Specify at least one profile"
    packages_file=$(mktemp)
    trap 'rm -f -- "$packages_file"' RETURN
    for profile_name in "$@"; do
        mapfile -t profile_packages < <(catalog_profile_packages "$profile_name")
        ((${#profile_packages[@]} > 0)) || error "Profile has no installable packages: $profile_name"
        printf '%s\n' "${profile_packages[@]}" >>"$packages_file"
    done
    mapfile -t packages < <(sort -u "$packages_file")
    header "Installing Profiles: $*"
    sudo pacman --sync --refresh --needed --noconfirm -- "${packages[@]}"
    for profile in "$@"; do
        success "Profile installed: $profile"
    done
}

install_catalog_applications() {
    local applications_file application_name
    local -a packages=()
    ((${#@} > 0)) || error "Specify at least one application"
    applications_file=$(mktemp)
    trap 'rm -f -- "$applications_file"' RETURN
    for application_name in "$@"; do
        mapfile -t application_packages < <(catalog_application_packages "$application_name")
        ((${#application_packages[@]} > 0)) || error "Application has no installable packages: $application_name"
        printf '%s\n' "${application_packages[@]}" >>"$applications_file"
    done
    mapfile -t packages < <(sort -u "$applications_file")
    header "Installing Applications: $*"
    sudo pacman --sync --refresh --needed --noconfirm -- "${packages[@]}"
    for application_name in "$@"; do
        success "Application installed: $application_name"
    done
}

workflow_apply() {
    local name=$1
    case "$name" in
        help|--help|-h) catalog_list_profiles ;;
        bio) install_catalog_profile bioinformatics ;;
        *) install_catalog_profile "$name" ;;
    esac
}

# ─── Service Management ──────────────────────────────────────

service_manage() {
    local name=$1
    local action=$2

    case "$name" in
        ssh)
            if [ "$action" = "on" ] || [ "$action" = "enable" ]; then
                sudo systemctl enable --now sshd
                success "SSH service enabled and started"
            elif [ "$action" = "off" ] || [ "$action" = "disable" ]; then
                sudo systemctl disable --now sshd
                success "SSH service disabled"
            else
                error "Unknown action: $action (use on/off)"
            fi
            ;;
        vnc)
            if [ "$action" = "on" ] || [ "$action" = "enable" ]; then
                require_root
                error "VNC is not available: a per-user TigerVNC session and firewall policy must be implemented first"
            elif [ "$action" = "off" ] || [ "$action" = "disable" ]; then
                sudo systemctl disable --now vncserver@:1
                success "VNC service disabled"
            fi
            ;;
        *)
            error "Unknown service: $name (supported: ssh, vnc)"
            ;;
    esac
}

# ─── Security ────────────────────────────────────────────────

security_status() {
    header "Security Posture"

    # UFW
    if command -v ufw &>/dev/null; then
        local ufw_status
        ufw_status=$(sudo ufw status 2>/dev/null | head -1)
        if echo "$ufw_status" | grep -q "active"; then
            success "UFW Firewall: ACTIVE"
        else
            warn "UFW Firewall: INACTIVE"
        fi
    else
        warn "UFW: NOT INSTALLED"
    fi

    # SSH
    if systemctl is-active sshd &>/dev/null; then
        warn "SSH Server: RUNNING (port $(grep -E '^Port' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' || echo 22))"
    else
        success "SSH Server: STOPPED"
    fi

    # fail2ban
    if systemctl is-active fail2ban &>/dev/null; then
        success "fail2ban: ACTIVE"
    else
        warn "fail2ban: INACTIVE"
    fi

    # Docker
    if systemctl is-active docker &>/dev/null; then
        info "Docker: RUNNING"
    else
        info "Docker: STOPPED"
    fi

    # KVM
    if [ -e /dev/kvm ]; then
        info "KVM: AVAILABLE"
    else
        info "KVM: NOT AVAILABLE"
    fi

    # Automatic updates
    if systemctl is-active pacman-contrib 2>/dev/null || systemctl is-active archlinux-contrib.timer 2>/dev/null; then
        success "Auto-updates: ACTIVE"
    else
        warn "Auto-updates: INACTIVE"
    fi

    echo ""
}

security_harden() {
    header "Applying Security Hardening"
    require_root

    # 1. Enable UFW
    info "Configuring firewall..."
    if ! command -v ufw &>/dev/null; then
        pacman -S --noconfirm ufw
    fi
    ufw default deny incoming
    ufw default allow outgoing
    ufw allow ssh
    ufw --force enable
    success "UFW enabled: deny incoming, allow outgoing, allow SSH"

    # 2. Install & configure fail2ban
    info "Installing fail2ban..."
    if ! command -v fail2ban-server &>/dev/null; then
        pacman -S --noconfirm fail2ban
    fi
    cat > /etc/fail2ban/jail.local << 'JAIL'
[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 5
backend = systemd

[sshd]
enabled = true
port = ssh
filter = sshd
maxretry = 5
bantime = 3600
JAIL
    systemctl enable --now fail2ban
    success "fail2ban configured (SSH: 3 retries -> 24h ban)"

    # 3. Kernel hardening
    info "Applying kernel hardening..."
    cat > /etc/sysctl.d/99-linxira-security.conf << 'SYSCTL'
# Linxira OS Security Hardening (moderate)

# Ignore ICMP redirects (prevent MITM)
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0

# Ignore source-routed packets
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0

# Enable SYN flood protection
net.ipv4.tcp_syncookies = 1

# Log Martian packets (spoofed source addresses)
net.ipv4.conf.all.log_martians = 1
net.ipv4.conf.default.log_martians = 1

# Disable IPv6 router advertisements
net.ipv6.conf.all.accept_ra = 0
net.ipv6.conf.default.accept_ra = 0

# Restrict dmesg to root only
kernel.dmesg_restrict = 1

# perf_event_paranoid=1 allows perf for root, =2 allows non-root too
# Default is 4 on Arch; 1 is a good balance for scientific work
kernel.perf_event_paranoid = 1
SYSCTL
    sysctl --system >/dev/null 2>&1
    success "Kernel hardening applied"

    # 4. File permissions
    info "Tightening file permissions..."
    chmod 700 /root 2>/dev/null || true
    chmod 600 /etc/shadow 2>/dev/null || true
    chmod 600 /etc/gshadow 2>/dev/null || true
    success "Critical file permissions tightened"

    echo ""
    header "Security Hardening Complete"
    echo "  - UFW firewall: enabled (deny incoming)"
    echo "  - fail2ban: active (SSH brute-force protection)"
    echo "  - Kernel: hardened (ICMP, SYN flood, ptrace restrictions)"
    echo "  - File permissions: tightened"
    echo ""
    echo "  ${YELLOW}Optional:${NC} linxira-config ssh on   (enable remote access)"
    echo "  ${YELLOW}Optional:${NC} linxira-config rdp on  (enable remote desktop)"
    echo "  ${YELLOW}Optional:${NC} linxira-config virt kvm-on (enable virtualization)"
    echo ""
}

# ─── UFW Management ──────────────────────────────────────────

ufw_manage() {
    local action=${1:-status}

    case $action in
        on|enable)
            require_root
            if ! command -v ufw &>/dev/null; then
                sudo pacman -S --noconfirm ufw
            fi
            sudo ufw default deny incoming
            sudo ufw default allow outgoing
            sudo ufw allow ssh
            sudo ufw --force enable
            success "UFW enabled"
            ;;
        off|disable)
            require_root
            sudo ufw disable
            success "UFW disabled"
            ;;
        status)
            if command -v ufw &>/dev/null; then
                sudo ufw status verbose
            else
                warn "UFW not installed"
            fi
            ;;
        allow)
            local port=${2:-}
            [ -z "$port" ] && error "Please specify a port: linxira-config security ufw allow <port>"
            validate_port "$port"
            require_root
            sudo ufw allow "$port"
            success "Port $port allowed through firewall"
            ;;
        *)
            error "Unknown UFW action: $action (use on/off/status/allow)"
            ;;
    esac
}

# ─── SSH Management ──────────────────────────────────────────

ssh_manage() {
    local action=${1:-status}

    case $action in
        on|enable|start)
            require_root
            sudo systemctl enable --now sshd
            # Ensure UFW allows SSH
            if command -v ufw &>/dev/null && sudo ufw status | grep -q "active"; then
                sudo ufw allow ssh 2>/dev/null || true
            fi
            local port=$(grep -E '^Port' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' || echo 22)
            success "SSH enabled on port $port"
            ;;
        off|disable|stop)
            require_root
            sudo systemctl disable --now sshd
            success "SSH disabled"
            ;;
        status)
            if systemctl is-active sshd &>/dev/null; then
                local port=$(grep -E '^Port' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' || echo 22)
                local ip=$(hostname -I | awk '{print $1}')
                success "SSH running on port $port"
                echo "  Connect: ssh user@${ip:-<ip>}:$port"
            else
                info "SSH is not running"
            fi
            ;;
        port)
            local port=${2:-}
            [ -z "$port" ] && error "Please specify a port number"
            validate_port "$port"
            require_root
            sudo sed -i "s/^#\?Port .*/Port $port/" /etc/ssh/sshd_config
            if command -v ufw &>/dev/null && sudo ufw status | grep -q "active"; then
                sudo ufw allow "$port/tcp"
            fi
            sudo systemctl restart sshd
            success "SSH port changed to $port"
            ;;
        keygen)
            local keyfile="$HOME/.ssh/id_ed25519"
            if [ -f "$keyfile" ]; then
                warn "Key already exists at $keyfile"
                read -p "Overwrite? (y/N): " confirm
                [ "$confirm" != "y" ] && return
            fi
            ssh-keygen -t ed25519 -C "linxira@$(hostname)" -f "$keyfile" -N ""
            success "SSH key generated: $keyfile"
            echo ""
            info "Public key (copy to remote server):"
            cat "${keyfile}.pub"
            ;;
        keyshow)
            local keyfile="$HOME/.ssh/id_ed25519.pub"
            if [ ! -f "$keyfile" ]; then
                warn "No SSH key found. Generate one with: linxira-config ssh keygen"
                return
            fi
            echo ""
            info "Your public key (copy this to authorized_keys):"
            cat "$keyfile"
            echo ""
            ;;
        *)
            error "Unknown SSH action: $action (use on/off/status/port/keygen/keyshow)"
            ;;
    esac
}

# ─── Remote Desktop ──────────────────────────────────────────

rdp_manage() {
    local action=${1:-on}

    case $action in
        on|enable)
            require_root
            error "RDP is not available: xrdp is not present in Linxira's signed repositories"
            ;;
        off|disable)
            require_root
            sudo systemctl disable --now xrdp
            success "RDP disabled"
            ;;
        vnc-on)
            require_root
            error "VNC is not available: a per-user TigerVNC session and firewall policy must be implemented first"
            ;;
        vnc-off)
            require_root
            sudo systemctl disable --now vncserver@:1
            success "VNC disabled"
            ;;
        *)
            error "Unknown RDP action: $action (use on/off/vnc-on/vnc-off)"
            ;;
    esac
}

# ─── Virtualization ──────────────────────────────────────────

virt_manage() {
    local action=${1:-status}

    case $action in
        status)
            header "Virtualization Support"
            # CPU virtualization support
            if grep -qE 'vmx|svm' /proc/cpuinfo; then
                success "CPU virtualization: ENABLED (VT-x/AMD-V)"
            else
                warn "CPU virtualization: NOT AVAILABLE (enable in BIOS)"
            fi

            # KVM
            if [ -e /dev/kvm ]; then
                success "KVM: AVAILABLE"
            else
                warn "KVM: NOT LOADED"
            fi

            # QEMU
            if command -v qemu-system-x86_64 &>/dev/null; then
                info "QEMU: INSTALLED ($(qemu-system-x86_64 --version | head -1))"
            else
                info "QEMU: NOT INSTALLED"
            fi

            # Docker
            if command -v docker &>/dev/null; then
                info "Docker: INSTALLED ($(docker --version | awk '{print $3}' | tr -d ','))"
            else
                info "Docker: NOT INSTALLED"
            fi

            # Podman
            if command -v podman &>/dev/null; then
                info "Podman: INSTALLED ($(podman --version | awk '{print $2}'))"
            else
                info "Podman: NOT INSTALLED"
            fi
            echo ""
            ;;
        kvm-on)
            require_root
            info "Enabling KVM/QEMU..."
            sudo pacman -S --noconfirm qemu-full virt-manager virt-viewer dnsmasq vde2 bridge-utils libvirt
            sudo systemctl enable --now libvirtd
            user=$(target_user)
            [[ -n $user ]] && sudo usermod -aG libvirt "$user" 2>/dev/null || true
            sudo sed -i 's/^#unix_sock_group/unix_sock_group/' /etc/libvirt/libvirtd.conf 2>/dev/null || true
            success "KVM/QEMU enabled. Log out and back in for group changes."
            ;;
        docker-on)
            require_root
            info "Installing Docker..."
            sudo pacman -S --noconfirm docker
            sudo systemctl enable --now docker
            user=$(target_user)
            [[ -n $user ]] && sudo usermod -aG docker "$user" 2>/dev/null || true
            if command -v ufw &>/dev/null && sudo ufw status | grep -q "active"; then
                sudo ufw allow 2376/tcp 2>/dev/null || true
            fi
            success "Docker enabled. Log out and back in for group changes."
            ;;
        podman-on)
            require_root
            info "Enabling Podman..."
            sudo systemctl enable --now podman.socket 2>/dev/null || true
            success "Podman enabled"
            ;;
        *)
            error "Unknown virt action: $action (use status/kvm-on/docker-on/podman-on)"
            ;;
    esac
}

