#!/bin/bash
# Linxira Config Hub - CLI Tool v2.2
# Cross-ecosource configuration & security manager

set -euo pipefail

VERSION="2.2.1"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CATALOG_PATH="${LINXIRA_CATALOG_PATH:-/usr/share/linxira/catalog/catalog-v3.json}"
CATALOG_STATE_PATH="${LINXIRA_CATALOG_STATE_PATH:-/var/lib/linxira/catalog/state-v1.json}"

# Colors
# ANSI-C quoted so the variables hold real ESC characters; plain cat (help
# heredoc) and printf output then render colors correctly without echo -e.
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m'

info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[OK]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }
header() { echo -e "\n${BOLD}${CYAN}=== $1 ===${NC}"; }

backend_pending() {
    error "This action is disabled until the Linxira system transaction backend provides plan, verify, receipt, and rollback support."
}

require_root() {
    local uid
    uid=$(id -u 2>/dev/null) || error "This command requires root privileges. Use sudo."
    [[ $uid =~ ^[0-9]+$ ]] || error "This command requires root privileges. Use sudo."
    [ "$uid" -eq 0 ] || error "This command requires root privileges. Use sudo."
}

validate_port() {
    local port=$1
    [[ $port =~ ^[0-9]+$ ]] && ((port >= 1 && port <= 65535)) || \
        error "Invalid port: $port (use a number from 1 to 65535)"
}

validate_dns_server() {
    local server=$1
    [[ $server =~ ^[0-9A-Fa-f:.]+$ ]] || error "Invalid DNS server address: $server"
    [[ $server != *[[:space:]/]* ]] || error "Invalid DNS server address: $server"
}

target_user() {
    local uid=${PKEXEC_UID:-}
    if [[ $uid =~ ^[0-9]+$ ]] && ((uid > 0)); then
        getent passwd "$uid" | cut -d: -f1
    elif [[ -n ${SUDO_USER:-} && ${SUDO_USER} != root ]]; then
        printf '%s\n' "$SUDO_USER"
    elif [[ ${USER:-} != root ]]; then
        printf '%s\n' "$USER"
    else
        logname 2>/dev/null || true
    fi
}

