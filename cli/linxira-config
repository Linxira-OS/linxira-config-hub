# Service management
service_manage() {
    local name=$1
    local action=$2
    
    info "Managing service: $name ($action)"
    
    case "$name" in
        ssh)
            if [ "$action" = "enable" ]; then
                sudo systemctl enable sshd
                sudo systemctl start sshd
                success "SSH service enabled"
            elif [ "$action" = "disable" ]; then
                sudo systemctl stop sshd
                sudo systemctl disable sshd
                success "SSH service disabled"
            fi
            ;;
        vnc)
            if [ "$action" = "enable" ]; then
                sudo pacman -S --noconfirm tigervnc
                sudo systemctl enable vncserver@:1
                success "VNC service enabled"
            elif [ "$action" = "disable" ]; then
                sudo systemctl stop vncserver@:1
                sudo systemctl disable vncserver@:1
                success "VNC service disabled"
            fi
            ;;
        *)
            error "Unknown service: $name"
            ;;
    esac
}

# GPU management
gpu_action() {
    local action=$1
    
    case $action in
        info)
            info "Detecting GPU..."
            lspci | grep -E "VGA|3D"
            ;;
        *)
            error "Unknown GPU action: $action"
            ;;
    esac
}

# System info
show_info() {
    info "System Information:"
    echo ""
    echo "OS: $(cat /etc/os-release | grep PRETTY_NAME | cut -d'"' -f2)"
    echo "Kernel: $(uname -r)"
    echo "Arch: $(uname -m)"
    echo "CPU: $(lscpu | grep "Model name" | cut -d: -f2 | xargs)"
    echo "Memory: $(free -h | awk '/^Mem:/{print $2}')"
    echo ""
    info "GPU:"
    lspci | grep -E "VGA|3D" | awk -F': ' '{print $2}'
    echo ""
    info "Installed Kernels:"
    pacman -Q | grep linux-cachy | awk '{print $1, $2}'
}

# Main
case "${1:-help}" in
    mirror)
        case "${2:-help}" in
            list) mirror_list ;;
            speed) mirror_speed ;;
            set) mirror_set "${3:-}" ;;
            *) show_help ;;
        esac
        ;;
    source)
        source_list
        ;;
    workflow)
        workflow_apply "${2:-help}"
        ;;
    service)
        service_manage "${2:-help}" "${3:-help}"
        ;;
    gpu)
        gpu_action "${2:-help}"
        ;;
    info)
        show_info
        ;;
    help|--help|-h)
        show_help
        ;;
    version|--version|-v)
        echo "linxira-config v${VERSION}"
        ;;
    *)
        error "Unknown command: $1"
        show_help
        ;;
esac
