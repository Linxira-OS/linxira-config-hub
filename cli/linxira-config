mirror_resolve() {
    local type=$1 selector=$2 id name country url probe
    if [[ $selector == https://* ]]; then
        printf '%s|%s\n' "${selector%/}" "${selector%/}"
        return
    fi
    while IFS='|' read -r id name country url probe; do
        if [[ $id == "$selector" ]]; then
            printf '%s|%s\n' "$url" "$probe"
            return
        fi
    done < <(mirror_records "$type")
    error "Unknown $type source: $selector"
}

mirror_current() {
    case "$1" in
        arch) awk '/^[[:space:]]*Server[[:space:]]*=/{print $3; exit}' /etc/pacman.d/mirrorlist 2>/dev/null || true ;;
        npm) command -v npm >/dev/null && npm config get registry 2>/dev/null || true ;;
        pip) command -v python >/dev/null && python -m pip config get global.index-url 2>/dev/null || true ;;
        aur)
            if [[ -f ${XDG_CONFIG_HOME:-$HOME/.config}/linxira/aur-git-url ]]; then
                cat -- "${XDG_CONFIG_HOME:-$HOME/.config}/linxira/aur-git-url"
            else
                printf '%s\n' 'https://aur.archlinux.org'
            fi
            ;;
        flatpak)
            command -v flatpak >/dev/null && \
                flatpak remotes --user --columns=name,url 2>/dev/null | \
                awk '$1 == "flathub" { print $2; exit }' || true
            ;;
        go)
            command -v go >/dev/null && go env GOPROXY 2>/dev/null || true
            ;;
    esac
}

mirror_list() {
    local type=${1:-arch} id name country url probe
    header "${type^^} Sources"
    while IFS='|' read -r id name country url probe; do
        printf '  %-10s %-22s %-7s %s\n' "$id" "$name" "[$country]" "$url"
    done < <(mirror_records "$type")
    if [[ $type == aur ]]; then
        printf '  %-10s %-22s %s\n' custom 'Configured custom URL' "$(mirror_current aur)"
        echo "  AUR source selection changes Git clone traffic only; RPC metadata stays official."
    elif [[ $type == flatpak ]]; then
        echo "  Flatpak remotes are unchanged until an explicit 'set' command is run."
    fi
    echo "  Current: $(mirror_current "$type")"
}

mirror_probe() {
    local probe=$1 result code seconds
    # Note: on MSYS/git-bash, curl may emit write errors to /dev/null inside
    # command substitution; we trust only the --write-out HTTP code.
    result=$(curl --location --silent --show-error --output /dev/null \
        --connect-timeout 4 --max-time 12 --retry 1 --retry-all-errors \
        --write-out '%{http_code} %{time_total}' \
        "$probe" 2>/dev/null)
    code=${result%% *}
    seconds=${result#* }
    [[ $code =~ ^(2|3)[0-9][0-9]$ ]] || return 1
    [[ $seconds =~ ^[0-9.]+$ ]] || seconds=0
    awk -v seconds="$seconds" 'BEGIN { printf "%.0f ms", seconds * 1000 }'
}

mirror_speed() {
    local type=${1:-arch} selector=${2:-} id name country url probe latency
    command -v curl >/dev/null || error "curl is required for mirror testing"
    header "Testing ${type^^} Sources"
    while IFS='|' read -r id name country url probe; do
        [[ -z $selector || $id == "$selector" ]] || continue
        if latency=$(mirror_probe "$probe"); then
            printf '  %-10s %-22s %-7s %s\n' "$id" "$name" "[$country]" "$latency"
        else
            printf '  %-10s %-22s %-7s %s\n' "$id" "$name" "[$country]" 'unreachable'
        fi
    done < <(mirror_records "$type")
    if [[ -n $selector && $selector == https://* ]]; then
        probe=${selector%/}
        [[ $type != aur ]] || probe="${selector%/}/yay.git/info/refs?service=git-upload-pack"
        if latency=$(mirror_probe "$probe"); then
            printf '  %-10s %-22s %s\n' custom 'Custom URL' "$latency"
        else
            error "The custom URL did not pass its connectivity check"
        fi
    fi
}

# mirror_auto: probe every source, pick the fastest reachable one, and apply it.
# Prints a comparison table and writes the winner with mirror_set (sudo for arch).
mirror_auto() {
    local type=${1:-} best_id="" best_ms=999999 id name country url probe latency ms
    [[ -n $type ]] || error "Specify a mirror type: linxira-config mirror <type> auto"
    case "$type" in
        arch|npm|pip|aur|flatpak|go) ;;
        *) error "Unknown mirror type: $type (use arch/npm/pip/aur/flatpak/go)" ;;
    esac
    command -v curl >/dev/null || error "curl is required for mirror testing"
    command -v sort >/dev/null || error "sort is required for mirror selection"
    header "Auto-selecting fastest ${type^^} source"
    while IFS='|' read -r id name country url probe; do
        if latency=$(mirror_probe "$probe"); then
            printf '  %-10s %-22s %-7s %s\n' "$id" "$name" "[$country]" "$latency"
            ms=${latency% *}
            if [[ $ms =~ ^[0-9]+$ ]] && ((ms < best_ms)); then
                best_ms=$ms
                best_id=$id
            fi
        else
            printf '  %-10s %-22s %-7s %s\n' "$id" "$name" "[$country]" 'unreachable'
        fi
    done < <(mirror_records "$type")
    if [[ -z $best_id ]]; then
        error "No reachable $type source found; check your network connection"
    fi
    success "Fastest source: $best_id (${best_ms} ms) — applying"
    mirror_set "$type" "$best_id"
}

aur_set_git_url() {
    local new_url=${1%/} state_dir state_file old_url
    state_dir=${XDG_CONFIG_HOME:-$HOME/.config}/linxira
    state_file=$state_dir/aur-git-url
    old_url=$(mirror_current aur)
    if [[ $old_url != https://aur.archlinux.org ]]; then
        git config --global --unset-all "url.${old_url}/.insteadOf" 2>/dev/null || true
    fi
    mkdir -p "$state_dir"
    printf '%s\n' "$new_url" >"$state_file"
    if [[ $new_url != https://aur.archlinux.org ]]; then
        git config --global --replace-all "url.${new_url}/.insteadOf" 'https://aur.archlinux.org/'
    fi
}

mirror_set() {
    local type=$1 selector=${2:-} resolved url probe latency
    [[ -n $selector ]] || error "Specify a source ID or HTTPS URL"
    resolved=$(mirror_resolve "$type" "$selector")
    IFS='|' read -r url probe <<<"$resolved"
    [[ $url == https://* ]] || error "Only HTTPS package sources are accepted"
    command -v curl >/dev/null || error "curl is required for source validation"
    if [[ $type == aur && $selector == https://* ]]; then
        probe="${url}/yay.git/info/refs?service=git-upload-pack"
    fi
    latency=$(mirror_probe "$probe") || error "Source validation failed: $url"

    case "$type" in
        arch)
            printf '# Generated by linxira-config\nServer = %s\n' "$url" | \
                sudo tee /etc/pacman.d/mirrorlist >/dev/null
            ;;
        npm)
            command -v npm >/dev/null || error "npm is not installed"
            npm config set registry "$url" --location=user
            ;;
        pip)
            command -v python >/dev/null || error "Python is not installed"
            python -m pip config --user set global.index-url "$url"
            ;;
        aur)
            command -v git >/dev/null || error "git is required for AUR source configuration"
            aur_set_git_url "$url"
            ;;
        flatpak)
            command -v flatpak >/dev/null || error "flatpak is not installed"
            flatpak remote-modify --user --url="$url" flathub 2>/dev/null || \
                flatpak remote-add --user flathub "$url"
            ;;
        go)
            command -v go >/dev/null || error "Go is not installed"
            go env -w "GOPROXY=${url},direct"
            ;;
    esac
    success "${type^^} source set to $url ($latency)"
}

mirror_reset() {
    mirror_set "$1" official
}

# ─── Miniforge Channels ───────────────────────────────────────

miniforge_root() {
    local root
    command -v conda >/dev/null || return 1
    root=$(conda info --base 2>/dev/null) || return 1
    case "${root##*/}" in
        miniforge*|mambaforge*) printf '%s\n' "$root" ;;
        *) return 1 ;;
    esac
}

require_miniforge() {
    miniforge_root >/dev/null || error "Miniforge is not installed; refusing to configure a generic Conda distribution"
}

conda_channel_records() {
    printf '%s\n' \
        'conda-forge|conda-forge|https://conda.anaconda.org/conda-forge' \
        'bioconda|Bioconda|https://conda.anaconda.org/bioconda'
}

conda_channel_resolve() {
    local selector=$1 id name url
    while IFS='|' read -r id name url; do
        [[ $id == "$selector" ]] && { printf '%s|%s\n' "$id" "$url"; return; }
    done < <(conda_channel_records)
    error "Unknown Miniforge channel: $selector (use conda-forge or bioconda)"
}

conda_channels_list() {
    require_miniforge
    header "Miniforge Channels"
    while IFS='|' read -r id name url; do
        printf '  %-12s %-14s %s\n' "$id" "$name" "$url"
    done < <(conda_channel_records)
    echo ""
    conda config --show channels 2>/dev/null || true
    echo "  channel_priority:"
    conda config --show channel_priority 2>/dev/null | sed 's/^/  /' || true
}

conda_channels_add() {
    local selector=${1:-} channel
    require_miniforge
    channel=$(conda_channel_resolve "$selector" | cut -d'|' -f1)
    conda config --add channels "$channel"
    conda config --set channel_priority strict
    success "Miniforge channel enabled: $channel"
}

conda_channels_remove() {
    local selector=${1:-} channel
    require_miniforge
    channel=$(conda_channel_resolve "$selector" | cut -d'|' -f1)
    conda config --remove channels "$channel" || true
    success "Miniforge channel removed: $channel"
}

conda_channels_reset() {
    require_miniforge
    conda config --remove-key channels || true
    conda config --remove-key channel_priority || true
    success "Miniforge channels reset"
}

conda_manage() {
    case "${1:-channels}" in
        channels)
            case "${2:-list}" in
                list) conda_channels_list ;;
                add) conda_channels_add "${3:-}" ;;
                remove) conda_channels_remove "${3:-}" ;;
                reset) conda_channels_reset ;;
                *) error "Unknown channel action: ${2:-} (use list/add/remove/reset)" ;;
            esac
            ;;
        *) error "Unknown Miniforge action: ${1:-} (use channels)" ;;
    esac
}

